# URL base de la API. En desarrollo se deja vacia para usar el proxy de Vite (/api -> :4000).
# En produccion apunta al backend, por ejemplo: https://api.talleraeg.com
VITE_API_URL=

# Solo para subir el video final de prueba del reporte de trabajo: un subdominio
# DNS-only (sin pasar por Cloudflare) que apunta directo a la VM, para que un video
# grande no choque con el limite de subida del plan de Cloudflare. Incluye "/api" al
# final. Vacio = esa subida tambien pasa por el dominio normal (VITE_API_URL o /api).
# Ver backend/CLAUDE.md.
VITE_VIDEO_UPLOAD_URL=
