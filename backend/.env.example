# Puerto del servidor HTTP
PORT=4000

# Origen permitido para CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar los JWT. Cambialo en produccion por un valor largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Tiempo de expiracion del token (formato de la libreria jsonwebtoken: 1h, 8h, 7d, etc.)
JWT_EXPIRES=8h

# ---------------------------------------------------------------------------
# Facturacion electronica (Digifact FEL Guatemala)
# Credenciales de prueba/produccion: solicitarlas a soporte@digifact.com.gt
# indicando el NIT del taller. Documentacion: https://documentacion.digifact.com/gt/api
# ---------------------------------------------------------------------------
# 'test' usa el sandbox de Digifact; 'prod' certifica documentos reales ante la SAT.
DIGIFACT_ENV=test
# Solo si Digifact cambia sus URLs; los valores por defecto ya apuntan al sandbox/produccion oficiales.
# DIGIFACT_TEST_BASE_URL=https://testnucgt.digifact.com
# DIGIFACT_PROD_BASE_URL=https://nucgt.digifact.com/gt.com.apinuc

# NIT del emisor (Taller AEG), sin guion. Digifact lo rellena a 12 digitos internamente.
DIGIFACT_NIT=
# Usuario y contrasena que asigna Digifact para ese NIT.
DIGIFACT_USERNAME=
DIGIFACT_PASSWORD=

# Datos fiscales del emisor que exige el documento NUC (Seller/BranchInfo).
# AfiliacionIVA: regimen de IVA del taller (GEN = general, u otro codigo que confirme Digifact/el contador).
DIGIFACT_AFILIACION_IVA=GEN
DIGIFACT_ESTABLECIMIENTO_CODIGO=1
DIGIFACT_ESTABLECIMIENTO_NOMBRE=
DIGIFACT_EMISOR_NOMBRE=
DIGIFACT_EMISOR_DIRECCION=
DIGIFACT_EMISOR_MUNICIPIO=
DIGIFACT_EMISOR_DEPARTAMENTO=
# Codigo geografico SAT (depto+municipio, ej. 01010 = Guatemala/Guatemala). Confirmar con Digifact/SAT.
DIGIFACT_EMISOR_CODIGO_GEOGRAFICO=
DIGIFACT_EMISOR_EMAIL=
